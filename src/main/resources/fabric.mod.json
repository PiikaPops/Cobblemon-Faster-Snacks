  "authors": ["coquelicot"],
  "license": "All-Rights-Reserved",
  "icon": "assets/cobblemon_faster_snacks/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["fr.coquelicot.fastersnacks.CobblemonFasterSnacks"${benchEntrypoint}]
  },
  "mixins": ["cobblemon_faster_snacks.mixins.json"${benchMixins}],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "fabric-api": "*",
    "cobblemon": "~1.8.4"
  }
}
